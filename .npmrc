# AD-28 — the declared engines are enforced at install, not merely declared.
#
# Matrix row 14 of story 1-12 says "the install *or* startup refuses", and only startup did: npm prints a
# warning for an `engines` mismatch and installs anyway unless this is set. So `npm ci` on npm 12 — the
# version that disables git-dependency resolution and install scripts, and therefore breaks AD-12's
# `npx github:<owner>/<repo>` delivery path — succeeded, and the failure arrived later and more obscurely.
# With this, the install refuses naming the bound, which is the other half of the row.
#
# It also makes a *dependency's* declared engines fatal rather than a warning. Verified rather than
# assumed: every `engines.node` in the installed tree is satisfied by both 22.22.0 (the pinned CI Node)
# and 24.21.0 (the Node this work was done on).
engine-strict=true
